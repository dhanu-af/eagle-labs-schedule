// Warehouse Management — Phase 1
// ---------------------------------------------------------------------------

enum WarehouseItemCategory {
  RAW_MATERIAL
  PACKAGING
  CONSUMABLE
  FINISHED_GOOD
}

enum WarehouseZone {
  DRY_STORE
  COLD_STORE
  QUARANTINE
  RELEASED
  REJECTED
  PACKAGING
  FINISHED_GOODS
}

model WarehouseLocation {
  id       String              @id @default(cuid())
  code     String              @unique
  label    String
  zone     WarehouseZone
  parentId String?
  parent   WarehouseLocation?  @relation("LocationTree", fields: [parentId], references: [id])
  children WarehouseLocation[] @relation("LocationTree")
  active   Boolean             @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  itemsDefaultingHere      WarehouseItem[]        @relation("ItemDefaultLocation")
  goodsReceivingLines      GoodsReceivingLine[]
  requestLinesReleasedHere WarehouseRequestLine[] @relation("ReleaseLocation")
  requestLinesReturnedHere WarehouseRequestLine[] @relation("ReturnLocation")
  ledgerEntriesFrom        MaterialLedgerEntry[]  @relation("LedgerFrom")
  ledgerEntriesTo          MaterialLedgerEntry[]  @relation("LedgerTo")

  @@index([zone])
  @@index([parentId])
}

model WarehouseItem {
  id                String                @id @default(cuid())
  itemCode          String                @unique
  name              String
  category          WarehouseItemCategory
  subCategory       String?
  ingredientId      String?               @unique
  ingredient        Ingredient?           @relation(fields: [ingredientId], references: [id])
  unit              String
  minimumStock      Float?
  maximumStock      Float?
  defaultLocationId String?
  defaultLocation   WarehouseLocation?    @relation("ItemDefaultLocation", fields: [defaultLocationId], references: [id])
  active            Boolean               @default(true)
  createdBy         String?
  updatedBy         String?
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt

  goodsReceivingLines    GoodsReceivingLine[]
  requestLines           WarehouseRequestLine[]
  ledgerEntries          MaterialLedgerEntry[]
  formulationIngredients FormulationIngredient[]
  purchaseOrderLines     PurchaseOrderLine[]
  shortageWatch          MaterialShortageWatch?

  @@index([category])
  @@index([ingredientId])
}

enum GoodsReceivingLineStatus {
  QUARANTINE
  RELEASED
  REJECTED
}

model GoodsReceiving {
  id              String   @id @default(cuid())
  supplierName    String
  poNumber        String?
  purchaseOrderId String?
  deliveryDate    DateTime
  invoiceRef      String?
  receivedByName  String
  checkedByName   String?
  approvedByName  String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  purchaseOrder PurchaseOrder?       @relation(fields: [purchaseOrderId], references: [id])
