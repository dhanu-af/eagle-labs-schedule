enum QcSampleType {
  FINISHED_PRODUCT
  STABILITY
  RETENTION
  INVESTIGATION
  COMPLAINT
}

enum QcSampleStatus {
  WAITING_COLLECTION
  COLLECTED
  WAITING_LAB
  IN_LABORATORY
  TESTING
  WAITING_RESULTS
  APPROVED
  REJECTED
  RETENTION
  EXPIRED
  DISPOSED
}

enum QcProductCategory {
  CAPSULE
  GUMMY
}

enum QcTestResult {
  PASS
  FAIL
}

/// GMP/TGA-style QC sample traceability: production -> sampling -> laboratory -> retention -> expiry/disposal.
/// sampleId (e.g. QC-2026-000124) is derived from `sequence` at creation time and then stored so it never changes.
model QcSample {
  id       String @id @default(cuid())
  sequence Int    @unique @default(autoincrement())
  sampleId String @unique

  productName   String
  batchNumber   String
  batchRecordId String?
  batchRecord   BatchRecord? @relation(fields: [batchRecordId], references: [id])

  manufacturingDate DateTime?
  expiryDate        DateTime?

  sampleType      QcSampleType
  productCategory QcProductCategory?
  quantity        Float
  unit            String

  collectedByName String?
  collectionDate  DateTime?
  collectionTime  String?

  productionRoom        String?
  sampleStorageLocation String?

  storageTemperature String?
  storageCondition   String?

  sentToLab          Boolean   @default(false)
  sentDate           DateTime?
  courierOrInternal  String?
  laboratoryName     String?
  laboratoryLocation String?
  receivedByQcName   String?
  receivedDate       DateTime?

  status  QcSampleStatus @default(WAITING_COLLECTION)
  remarks String?

  createdByName String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  labTest         QcLabTest?
  retentionRecord QcRetentionRecord?
  attachments     QcSampleAttachment[]

  @@index([batchNumber])
  @@index([status])
  @@index([sampleType])
}

enum QcAttachmentKind {
  COA
  LAB_REPORT
  PHOTO
  OTHER
}

/// Real files (COA/lab report PDFs, product photos) for a sample -- distinct
/// from the "COA Upload"/"Laboratory Report"/"Photographs" rows in the lab
/// test checklist below, which are just Pass/Fail + a text-field stand-in for
/// this. A dedicated sample-FK'd model rather than reusing the generic,
/// already-unused CheckAttachment (checkType/checkId) above -- this app's own
/// convention for QC-adjacent data is dedicated typed models (QcLabTest,
/// QcRetentionRecord), not a shared polymorphic table nothing else uses.
model QcSampleAttachment {
  id             String           @id @default(cuid())
  sampleId       String
  sample         QcSample         @relation(fields: [sampleId], references: [id], onDelete: Cascade)
  kind           QcAttachmentKind
  url            String
  fileName       String
  fileSizeBytes  Int
  uploadedByName String?
  uploadedAt     DateTime         @default(now())

  @@index([sampleId])
}

/// Header record for a sample's lab testing pass -- the actual checklist rows are QcLabTestItem,
/// generated from the CAPSULE/GUMMY template in qc-sample-defaults.ts for the sample's productCategory.
model QcLabTest {
  id       String   @id @default(cuid())
  sampleId String   @unique
  sample   QcSample @relation(fields: [sampleId], references: [id], onDelete: Cascade)

  testedByName String?
  testedAt     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items QcLabTestItem[]
}

/// One row of the product-category test checklist (e.g. section "Physical Testing", parameter "Appearance").
model QcLabTestItem {
  id        String    @id @default(cuid())
  labTestId String
  labTest   QcLabTest @relation(fields: [labTestId], references: [id], onDelete: Cascade)

  section   String
  parameter String
  result    QcTestResult?
  details   String?
  sortOrder Int

  @@index([labTestId])
}

model QcRetentionRecord {
  id       String   @id @default(cuid())
  sampleId String   @unique
  sample   QcSample @relation(fields: [sampleId], references: [id], onDelete: Cascade)

  shelf             String?
  cabinet           String?
  boxNumber         String?
  position          String?
  quantityRemaining Float?
  opened            Boolean   @default(false)
  lastChecked       DateTime?
  expiryDate        DateTime?
  destroyDate       DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([expiryDate])
}

enum MfgBatchStatus {
  IN_PROGRESS
  COMPLETED
}

enum MfgMaterialGroup {
  RAW_INGREDIENT
  RAW_ACTIVE_INGREDIENT
  RAW_EXCIPIENT
  PACKAGING_EMPTY_CAPSULE
  PACKAGING_EMPTY_BOTTLE
  PACKAGING_CAP
  PACKAGING_DESICCANT
  PACKAGING_LABEL
  PACKAGING_CARTON
  PACKAGING_INSERT
  PACKAGING_SHRINK_WRAP
  PACKAGING_SHIPPER
  PACKAGING_PALLET
}

enum MfgPackagingMaterialType {
  LABEL
  CARTON
  INSERT
  SHRINK_WRAP
  SHIPPER
}

/// End-to-end GMP/TGA-style manufacturing reconciliation: Warehouse Issue -> Blending -> Encapsulation
/// -> Bottling -> X-Ray/Metal Detection -> Packaging -> Finished Goods Warehouse -> Dispatch. Each stage
/// is its own record, filled in independently as production reaches it. Balance/yield figures (Quantity
/// Balance, Blend Yield %, Capsule Yield %, etc.) are computed at render time from the raw quantities
/// stored here -- never persisted -- matching the existing yield% precedent in batch-record-client.tsx.
model MfgBatch {
  id            String       @id @default(cuid())
  batchNumber   String
  productName   String
  batchRecordId String?
  batchRecord   BatchRecord? @relation(fields: [batchRecordId], references: [id])

  status  MfgBatchStatus @default(IN_PROGRESS)
  remarks String?

  createdByName String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  warehouseIssue         MfgWarehouseIssue?
  blending               MfgBlending?
  encapsulation          MfgEncapsulation?
  bottling               MfgBottling?
  xrayInspection         MfgXrayInspection?
  packaging              MfgPackaging?
  finishedGoodsWarehouse MfgFinishedGoodsWarehouse?
  dispatchEvents         MfgDispatchEvent[]

  @@index([batchNumber])
  @@index([status])
}

model MfgWarehouseIssue {
  id         String   @id @default(cuid())
  mfgBatchId String   @unique
  mfgBatch   MfgBatch @relation(fields: [mfgBatchId], references: [id], onDelete: Cascade)

  issuedByName String?
  issueDate    DateTime?
  remarks      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lines MfgMaterialIssueLine[]
}

/// One row per material issued for a batch -- raw material or packaging material, discriminated by
/// materialGroup. New batches pre-populate one line per material type from a default template in
/// mfg-reconciliation-defaults.ts, the same way QcLabTestItem rows are seeded from a checklist template.
model MfgMaterialIssueLine {
  id               String            @id @default(cuid())
  warehouseIssueId String
  warehouseIssue   MfgWarehouseIssue @relation(fields: [warehouseIssueId], references: [id], onDelete: Cascade)

  materialGroup     MfgMaterialGroup
  materialCode      String?
  description       String
  supplier          String?
  lotBatchNumber    String?
  expiryDate        DateTime?
  quantityRequested Float?
  quantityIssued    Float?
  quantityReturned  Float?
  sortOrder         Int

  @@index([warehouseIssueId])
}

model MfgBlending {
  id         String   @id @default(cuid())
  mfgBatchId String   @unique
  mfgBatch   MfgBatch @relation(fields: [mfgBatchId], references: [id], onDelete: Cascade)

  totalTheoreticalWeightKg Float?
  actualWeightKg           Float?
  blendBatchNumber         String?

  powderRemainingKg     Float?
  blenderResidueKg      Float?
  sieveLossKg           Float?
  dustLossKg            Float?
  spillagesKg           Float?
  qcSamplesQty          Float?
  retentionSamplesQty   Float?
  destroyedMaterialKg   Float?
  returnedToWarehouseKg Float?

  totalBlendProducedKg Float?

  blendedByName String?
  blendedAt     DateTime?
  remarks       String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Mirrors the real "CAPSULE RECONCILIATION" paper form (xlsx) field-for-field and formula-for-formula.
/// Derived figures (theoretical/produced/sample/reject capsule counts, blend accounted/unaccounted for,
/// and the 4 reconciliation %%s) are never stored -- computed at render time from these raw inputs,
/// exactly like every other yield/balance figure in this module.
model MfgEncapsulation {
  id         String   @id @default(cuid())
  mfgBatchId String   @unique
  mfgBatch   MfgBatch @relation(fields: [mfgBatchId], references: [id], onDelete: Cascade)

  targetCapsuleFillWeightMg Float? // "Target Capsule Fill Weight" -- powder only
  avgCapsuleFullWeightMg    Float? // "Average Capsule Full Weight" -- shell + powder

  issuedBulkBlendKg  Float? // "Issued Bulk Blend"
  capsulesProducedKg Float? // "Capsules Produced" (weighed)
  capsuleSamplesKg   Float? // "Capsules Samples"
  rejectCapsulesKg   Float? // "Reject Capsules"
  rejectPowderKg     Float? // "Reject Powder"

  avgCapsuleFillWeightMg   Float? // "Average Capsule Fill Weight" (Capsule Properties) -- measured, powder only
  avgCapsuleLengthMm       Float?
  avgDisintegrationMinutes Int?
  avgDisintegrationSeconds Int?
  disintegrationResult     String? // "Pass" | "Fail"

  completedByName String?
  completedAt     DateTime?
  checkedByName   String?
  checkedAt       DateTime?
  comments        String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Mirrors the real "BOTTLE RECONCILIATION" paper form (xlsx) field-for-field and formula-for-formula.
/// Derived figures (capsules required/theoretical/used/reject, theoretical bottles, reject bottles/
/// desiccants/caps, and the 5 reconciliation %%s) are never stored -- computed at render time.
model MfgBottling {
  id         String   @id @default(cuid())
  mfgBatchId String   @unique
  mfgBatch   MfgBatch @relation(fields: [mfgBatchId], references: [id], onDelete: Cascade)

  totalCapsuleBulkWeightKg Float? // "Total Capsule Bulk Weight"
  avgCapsuleFullWeightMg   Float? // "Average Capsule Full Weight"

  plannedQuantityBottles  Int? // "Planned Quantity"
  capsuleReceivedKg       Float? // "Capsule Received"
  bottlesProduced         Int? // "Bottles Produced"
  bottleUsed              Int? // "Bottle Used" (empty bottles issued)
  desiccantsUsed          Int?
  capsUsed                Int?
  targetCapsulesPerBottle Int? // the sheet's hardcoded "31" -- kept per-batch instead

  completedByName String?
  completedAt     DateTime?
  checkedByName   String?
  checkedAt       DateTime?
  comments        String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model MfgXrayInspection {
  id         String   @id @default(cuid())
  mfgBatchId String   @unique
  mfgBatch   MfgBatch @relation(fields: [mfgBatchId], references: [id], onDelete: Cascade)

  bottlesReceived Int?
  bottlesScanned  Int?
  passed          Int?
  failed          Int?
  reworked        Int?
  destroyed       Int?
  released        Int?

  rejectMetalDetection   Int?
  rejectXrayFailure      Int?
  rejectUnderweight      Int?
  rejectOverweight       Int?
  rejectDamagedBottle    Int?
  rejectMissingCap       Int?
  rejectMissingDesiccant Int?

  inspectedByName String?
  inspectedAt     DateTime?
  remarks         String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model MfgPackaging {
  id         String   @id @default(cuid())
  mfgBatchId String   @unique
  mfgBatch   MfgBatch @relation(fields: [mfgBatchId], references: [id], onDelete: Cascade)

  packedBottles   Int?
  cartonsProduced Int?
  casesProduced   Int?

  packedByName String?
  packedAt     DateTime?
  remarks      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lines MfgPackagingMaterialLine[]
}

model MfgPackagingMaterialLine {
  id          String       @id @default(cuid())
  packagingId String
  packaging   MfgPackaging @relation(fields: [packagingId], references: [id], onDelete: Cascade)

  materialType MfgPackagingMaterialType
  issued       Float?
  used         Float?
  damaged      Float?
  returned     Float?
  destroyed    Float?
  sortOrder    Int

  @@index([packagingId])
}

model MfgFinishedGoodsWarehouse {
  id         String   @id @default(cuid())
  mfgBatchId String   @unique
  mfgBatch   MfgBatch @relation(fields: [mfgBatchId], references: [id], onDelete: Cascade)

  finishedGoodsReceived Int?
  qaReleased            Boolean   @default(false)
  qaReleasedByName      String?
  qaReleasedAt          DateTime?
  storageLocation       String?
  warehouseBalance      Int?
  batchNumber           String?
  expiryDate            DateTime?
  remarks               String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model MfgDispatchEvent {
  id         String   @id @default(cuid())
  mfgBatchId String
  mfgBatch   MfgBatch @relation(fields: [mfgBatchId], references: [id], onDelete: Cascade)

  customer            String
  salesOrder          String?
  batchNumber         String?
  expiryDate          DateTime?
  casesDispatched     Int?
  bottlesDispatched   Int?
  dispatchDate        DateTime?
  remainingStockAfter Int?
  dispatchedByName    String?
  remarks             String?

  createdAt DateTime @default(now())

  @@index([mfgBatchId])
}

/// Customer Order Management — Phase 1 (Foundation). Converts customer demand into a
/// tracked order against a real Product/SKU and BOM (Formulation), with a material
/// availability check computed live off the existing MaterialLedgerEntry ledger. Does
/// NOT model finite capacity (no Machine/WorkCenter exists yet) — that's Phase 2.
enum CustomerOrderStatus {
  DRAFT
  RECEIVED
  UNDER_REVIEW
  MATERIAL_CHECK
  CONFIRMED
  IN_PRODUCTION
  QA_QC
  READY_TO_DISPATCH
  DISPATCHED
  DELIVERED
  CLOSED
  ON_HOLD
  CANCELLED
}

enum OrderPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

/// First-class Product/SKU — until now every module (Formulation, BatchRecord, MfgBatch,
/// QcSample, DailyTask, Kpi) identified a product only by a free-text productName string.
/// This does not retrofit those — it's the anchor for new Customer Order lines going
/// forward, optionally pointing at the Formulation that is its BOM.
model Product {
  id            String   @id @default(cuid())
  sku           String   @unique
  name          String
  category      String?
  defaultUnit   String   @default("kg")
  formulationId String?
  active        Boolean  @default(true)
  createdById   String?
  createdByName String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  formulation Formulation?        @relation(fields: [formulationId], references: [id])
  orderLines  CustomerOrderLine[]
  mpsEntries  WeeklyMpsEntry[]

  @@index([formulationId])
}

model Customer {
  id           String        @id @default(cuid())
  code         String        @unique
  name         String
  contactName  String?
  contactEmail String?
  contactPhone String?
  address      String?
  priorityTier OrderPriority @default(NORMAL)
  notes        String?
  active       Boolean       @default(true)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  orders CustomerOrder[]
}

model CustomerOrder {
  id                    String              @id @default(cuid())
  orderNumber           String              @unique
  customerId            String
  customerPoNumber      String?
  customerRequestNumber String?
  orderDate             DateTime            @default(now())
  requestedDeliveryDate DateTime
  confirmedDeliveryDate DateTime?
  priority              OrderPriority       @default(NORMAL)
  status                CustomerOrderStatus @default(DRAFT)
  responsiblePlannerId  String?
  salesOwnerId          String?
  shippingRequirements  String?
  specialRequirements   String?
  notes                 String?
  createdById           String?
  createdByName         String?
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  customer           Customer            @relation(fields: [customerId], references: [id])
  responsiblePlanner User?               @relation("CustomerOrderPlanner", fields: [responsiblePlannerId], references: [id])
  salesOwner         User?               @relation("CustomerOrderSalesOwner", fields: [salesOwnerId], references: [id])
  lines              CustomerOrderLine[]

  @@index([customerId])
  @@index([status])
  @@index([requestedDeliveryDate])
}

model CustomerOrderLine {
  id                   String   @id @default(cuid())
  customerOrderId      String
  lineNumber           Int
  productId            String
  quantity             Float
  unit                 String
  packagingRequirement String?
  artworkStatus        String?
  notes                String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  customerOrder CustomerOrder @relation(fields: [customerOrderId], references: [id], onDelete: Cascade)
  product       Product       @relation(fields: [productId], references: [id])
  batchRecords  BatchRecord[]

  @@index([customerOrderId])
  @@index([productId])
}

/// Capacity Planning — Phase 2. A small, real machine list (this is a 2-3 machine
/// operation, not a large multi-line factory) with a simple standard-hours-per-day
/// default plus per-date exceptions (maintenance, holidays). Deliberately not a
/// shift/calendar engine -- covers the real cases at this scale without over-building.
model Machine {
  id                  String   @id @default(cuid())
  code                String   @unique
  name                String
  workCenter          String?
  standardHoursPerDay Float    @default(8)
  active              Boolean  @default(true)
  notes               String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  capacityExceptions MachineCapacityException[]
  batchRecords       BatchRecord[]
  mpsEntries         WeeklyMpsEntry[]
  recoveryActions    CapacityRecoveryAction[]
}

model MachineCapacityException {
  id                     String   @id @default(cuid())
  machineId              String
  date                   DateTime
  hoursAvailableOverride Float
  reason                 String?
  createdAt              DateTime @default(now())

  machine Machine @relation(fields: [machineId], references: [id], onDelete: Cascade)

  @@unique([machineId, date])
}

/// Procurement — supplier-side purchase order tracking. Until now GoodsReceiving was the
/// only supplier-related record, and it's post-hoc (what already arrived); this is the
/// first forward-looking "what's on order and when is it due" concept, so a customer
/// order material shortage can point at a real incoming PO instead of a dead end.
model Supplier {
  id           String   @id @default(cuid())
  code         String   @unique
  name         String
  contactName  String?
  contactEmail String?
  contactPhone String?
  leadTimeDays Int?
  notes        String?
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  purchaseOrders PurchaseOrder[]
}

enum PurchaseOrderStatus {
  DRAFT
  SENT
  CONFIRMED
  PARTIALLY_RECEIVED
  RECEIVED
  CANCELLED
}

model PurchaseOrder {
  id                   String              @id @default(cuid())
  poNumber             String              @unique
  supplierId           String
  orderDate            DateTime            @default(now())
  expectedDeliveryDate DateTime
  status               PurchaseOrderStatus @default(DRAFT)
  notes                String?
  createdById          String?
  createdByName        String?
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt

  supplier        Supplier            @relation(fields: [supplierId], references: [id])
  lines           PurchaseOrderLine[]
  goodsReceivings GoodsReceiving[]

  @@index([supplierId])
  @@index([status])
  @@index([expectedDeliveryDate])
}

model PurchaseOrderLine {
  id              String   @id @default(cuid())
  purchaseOrderId String
  itemId          String
  quantity        Float
  unit            String
  notes           String?
  createdAt       DateTime @default(now())

  purchaseOrder PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  item          WarehouseItem @relation(fields: [itemId], references: [id])

  @@index([purchaseOrderId])
  @@index([itemId])
}

// ---------------------------------------------------------------------------
// Site Action Log -- cross-functional exception/action register (Planning
// Manager Master doc, "Site Planning Rules and Escalation" + "Daily Site
// Control Meeting"). Manually raised and owned, unlike Notification (system-
// generated) or AuditLog (immutable system trail). "Days Open" is never
// stored -- always computed at render from dateRaised/closedDate, matching
// the existing computed-risk precedent in customer-order-defaults.ts.
// ---------------------------------------------------------------------------

enum ActionSourceSection {
  SALES_CUSTOMER_SERVICE
  PRODUCTION_PLANNING
  PROCUREMENT_MATERIALS
  WAREHOUSE
  QC_QA
  MAINTENANCE_ENGINEERING
  PRODUCTION_SHIFTS
  DISPATCH_DELIVERY
  CROSS_FUNCTIONAL
}

enum ActionLogStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum EscalationLevel {
  GREEN
  AMBER
  RED
}

model SiteActionLog {
  id              String              @id @default(cuid())
  actionNumber    String              @unique
  dateRaised      DateTime            @default(now())
  sourceSection   ActionSourceSection
  issue           String
  businessImpact  String?
  priority        Priority            @default(MEDIUM)
  owner           String
  dueDate         DateTime?
  status          ActionLogStatus     @default(OPEN)
  escalationLevel EscalationLevel     @default(GREEN)
  resolution      String?
  closedDate      DateTime?
  createdById     String?
  createdByName   String?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  @@index([status])
  @@index([dueDate])
  @@index([sourceSection])
  @@index([escalationLevel])
}

// ---------------------------------------------------------------------------
// Weekly KPI Scorecard (Planning Manager Master doc, "Core KPI Scorecard" +
// "Weekly Manager Update"). Unlike the render-time-only computations elsewhere
// (order risk, Mfg Reconciliation yield%), this one snapshots per week on
// purpose -- it's an explicit management-review record ("enter weekly results"),
// and several fields (scheduleAdherencePct, qcOnTimeReleasePct,
// inventoryAccuracyPct) have no live source at all, so they can only ever be
// manual entry. overallStatus reuses EscalationLevel (Green/Amber/Red) rather
// than a new enum, same "reuse across modules" precedent as the Priority enum.
// ---------------------------------------------------------------------------

model WeeklyKpiScorecard {
  id         String   @id @default(cuid())
  weekEnding DateTime @unique

  otifPct                  Float?
  scheduleAdherencePct     Float?
  materialAvailabilityPct  Float?
  productionAttainmentPct  Float?
  averageYieldPct          Float?
  qcOnTimeReleasePct       Float?
  inventoryAccuracyPct     Float?
  pastDueOrders            Int?
  criticalShortages        Int?
  unplannedScheduleChanges Int?

  overallStatus       EscalationLevel @default(GREEN)
  managementComment   String?
  autoUpdateComputed  Boolean         @default(false)

  createdById   String?
  createdByName String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([weekEnding])
}

// ---------------------------------------------------------------------------
// Weekly MPS (Planning Manager Master doc, "Master Production Schedule" +
// "Site Master Plan Template"). One row = one line/product's planned production
// for a Monday..Sunday week. plannedQtyKg is never stored -- always
// batchSizeKg * plannedBatches, computed in weekly-mps-defaults.ts. materialReady
// is likewise never stored -- computed live against the linked Product's
// Formulation and real warehouse stock, reusing the exact same helpers the
// Customer Order material check already uses (scaleIngredientQtyKg,
// checkIngredientAgainstStock, rollUpMaterialStatus). qcReady/maintenanceReady
// stay real boolean columns -- no live QC-readiness or maintenance-readiness
// signal exists anywhere else in the app to compute them from.
// ---------------------------------------------------------------------------

model WeeklyMpsEntry {
  id             String    @id @default(cuid())
  weekEnding     DateTime
  machineId      String?
  productId      String
  batchSizeKg    Float
  plannedBatches Int       @default(1)
  requiredDate   DateTime?
  priority       Priority  @default(MEDIUM)

  frozen           Boolean @default(false)
  qcReady          Boolean @default(false)
  maintenanceReady Boolean @default(false)

  notes         String?
  createdById   String?
  createdByName String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  machine Machine? @relation(fields: [machineId], references: [id])
  product Product  @relation(fields: [productId], references: [id])

  @@index([weekEnding])
  @@index([machineId])
  @@index([productId])
}

// ---------------------------------------------------------------------------
// Material Shortage Register (Planning Manager Master doc, "Material
// Requirements and Shortage Register"). The actual shortage figures (required
// qty, usable stock, net shortage, incoming PO) are never stored here -- they're
// computed live in material-shortage-actions.ts by netting demand for a
// WarehouseItem across every active Customer Order at once, unlike
// getOrderMaterialChecks() which deliberately checks one order at a time. This
// table only holds the workflow overlay a computed number can't provide: who's
// on it, what they're doing, and whether it's resolved. Reuses ActionLogStatus
// rather than a new enum, same "one status vocabulary" precedent as Priority/
// EscalationLevel elsewhere.
// ---------------------------------------------------------------------------

model MaterialShortageWatch {
  id              String          @id @default(cuid())
  warehouseItemId String          @unique
  action          String?
  owner           String?
  status          ActionLogStatus @default(OPEN)

  updatedById   String?
  updatedByName String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  warehouseItem WarehouseItem @relation(fields: [warehouseItemId], references: [id], onDelete: Cascade)
}

// ---------------------------------------------------------------------------
// Capacity Planning -- Weekly Rollup recovery action. The utilization figures
// themselves stay exactly as computed in capacity-planning-defaults.ts
// (computeMachineCapacity), just bucketed into Mon..Sun weeks instead of single
// days -- never persisted here. This table only holds what a human decides to
// do about an overloaded week, one row per (machine, week). Reuses
// ActionLogStatus, same one-status-vocabulary precedent as the other overlays.
// ---------------------------------------------------------------------------

model CapacityRecoveryAction {
  id             String          @id @default(cuid())
  machineId      String
  weekEnding     DateTime
  recoveryAction String?
  owner          String?
  status         ActionLogStatus @default(OPEN)

  updatedById   String?
  updatedByName String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  machine Machine @relation(fields: [machineId], references: [id], onDelete: Cascade)

  @@unique([machineId, weekEnding])
  @@index([weekEnding])
}

// ---------------------------------------------------------------------------
// Task Requests -- one person sending a specific named person an urgent task.
// Deliberately point-to-point (fromUserId -> toUserId), unlike DailyTask/
// WeeklyAssignment which are a supervisor assigning work down within their own
// team's planning tool. Keyed on User (the login/session identity), NOT
// Employee: in this system's real data, only one account (the Super Admin) has
// a linked Employee record -- every other real login has employeeId = null.
// An earlier version of this table used Employee and was undeliverable for
// almost every real user as a result (confirmed by testing -- Dhanu sent tasks
// that never appeared for the recipient because that recipient's session had
// no employeeId to match against). User.id is what every session always has.
// Sending also fires the existing Notification (src/lib/notify.ts's
// notifyEmployee) when the recipient does happen to have an Employee link, as
// a bonus for the bell -- but delivery of the core feature never depends on it.
// ---------------------------------------------------------------------------

enum TaskRequestStatus {
  PENDING
  IN_PROGRESS
  DONE
}

model TaskRequest {
  id         String            @id @default(cuid())
  fromUserId String
  toUserId   String
  title      String
  message    String?
  /// Optional deep link back to whatever record/page prompted this request (e.g.
  /// "/checks" after submitting an Environmental Check that needs review) --
  /// plain string, same convention as Notification.link.
  link       String?
  priority   Priority          @default(MEDIUM)
  dueDate    DateTime?
  status     TaskRequestStatus @default(PENDING)
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt

  fromUser User @relation("SentTaskRequests", fields: [fromUserId], references: [id])
  toUser   User @relation("ReceivedTaskRequests", fields: [toUserId], references: [id])

  @@index([toUserId, status])
  @@index([fromUserId])
}

// ---------------------------------------------------------------------------
// Capsule Calculation -- quick production-math tool: given a target bottle
// count, how many kg of powder to blend; or given a blended kg amount, how
// many capsules/bottles that yields. Same "kg <-> capsules via avg fill
// weight" formula Mfg Reconciliation's capsulesFromKg() already uses, just a
// standalone planning calculator rather than a record tied to a real batch.
// Every run a user submits is saved as a row here, building a running log.
// ---------------------------------------------------------------------------

enum CalculationDirection {
  BOTTLES_TO_KG
  KG_TO_OUTPUT
  /// Post-encapsulation: a bag/bucket of finished (pressed) capsules weighed in kg ->
  /// capsule count & bottle output. Same kg<->capsules math as KG_TO_OUTPUT, but the
  /// weight figure is the capsule's AVERAGE FULL weight (shell + fill), not the fill
  /// weight alone -- a different real quantity, so kept as its own direction rather
  /// than merged with KG_TO_OUTPUT.
  BAGGED_KG_TO_OUTPUT
  /// Procurement: given a capsule count, how much empty-shell weight and how many
  /// boxes of empty shells to buy. Reuses capsulesPerBottle as "capsules per box" and
  /// avgFillWeightMg as "empty shell weight (mg)" -- see the field-reuse note on
  /// CapsuleCalculation below.
  CAPSULES_TO_SHELLS
}

/// Every field here is reused across all four CalculationDirections with a different
/// real-world meaning depending on direction (capsulesPerBottle doubles as "capsules
/// per box" for CAPSULES_TO_SHELLS; avgFillWeightMg doubles as "full weight" for
/// BAGGED_KG_TO_OUTPUT and "empty shell weight" for CAPSULES_TO_SHELLS; resultBottles
/// doubles as "boxes needed" for CAPSULES_TO_SHELLS). The UI's per-direction label maps
/// (src/lib/capsule-calculation-defaults.ts) are the source of truth for what each
/// field means on a given row -- don't assume the column name literally describes the
/// value without checking `direction` first.
model CapsuleCalculation {
  id                String               @id @default(cuid())
  direction         CalculationDirection
  label             String?
  capsulesPerBottle Int
  avgFillWeightMg   Float
  /// The user's one given input: target bottle count for BOTTLES_TO_KG, blended kg for
  /// KG_TO_OUTPUT/BAGGED_KG_TO_OUTPUT, or capsule count for CAPSULES_TO_SHELLS.
  inputValue        Float
  resultKg          Float?
  resultCapsules    Float?
  resultBottles     Float?
  createdById       String?
  createdByName     String?
  createdAt         DateTime             @default(now())

  @@index([createdAt])
}
