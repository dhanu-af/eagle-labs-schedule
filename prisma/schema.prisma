  returnSubmittedAt      DateTime?
  returnVerifiedByName   String?
  returnVerifiedAt       DateTime?
  returnQaApprovedByName String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  ledgerEntries MaterialLedgerEntry[]

  @@index([requestId])
  @@index([itemId])
}

enum LedgerEntryType {
  RECEIPT
  RESERVE
  ISSUE
  RETURN
  ADJUSTMENT
  RECOUNT
  STATUS_CHANGE
}

enum StockBucket {
  AVAILABLE
  RESERVED
  IN_PRODUCTION
  AWAITING_VERIFICATION
  EXPIRED
  DAMAGED
  BLOCKED
}

model MaterialLedgerEntry {
  id       String @id @default(cuid())
  sequence Int    @unique @default(autoincrement())

  entryType LedgerEntryType
  itemId    String
  item      WarehouseItem   @relation(fields: [itemId], references: [id])
  lotNumber String?
  quantity  Float
  unit      String

  fromBucket StockBucket?
  toBucket   StockBucket?

  fromLocationId String?
  fromLocation   WarehouseLocation? @relation("LedgerFrom", fields: [fromLocationId], references: [id])
  toLocationId   String?
  toLocation     WarehouseLocation? @relation("LedgerTo", fields: [toLocationId], references: [id])

  batchReference       String?
  requestId            String?
  request              WarehouseMaterialRequest? @relation(fields: [requestId], references: [id])
  requestLineId        String?
  requestLine          WarehouseRequestLine?     @relation(fields: [requestLineId], references: [id])
  goodsReceivingLineId String?
  goodsReceivingLine   GoodsReceivingLine?       @relation(fields: [goodsReceivingLineId], references: [id])

  performedByName String
  approvedByName  String?
  reasonCode      String?

  resultingBalance Float

  createdAt DateTime @default(now())

  @@index([itemId, lotNumber])
  @@index([requestId])
  @@index([entryType])
  @@index([createdAt])
