model GoodsReceivingLine {
  id                      String                   @id @default(cuid())
  goodsReceivingId        String
  goodsReceiving          GoodsReceiving           @relation(fields: [goodsReceivingId], references: [id], onDelete: Cascade)
  itemId                  String
  item                    WarehouseItem            @relation(fields: [itemId], references: [id])
  lotNumber               String
  supplierLot             String?
  internalLot             String?
  expiryDate              DateTime?
  manufactureDate         DateTime?
  quantity                Float
  unit                    String
  coaReference            String?
  photoReference          String?
  deliveryDocketReference String?
  storageCondition        String?
  status                  GoodsReceivingLineStatus @default(QUARANTINE)
  locationId              String?
  location                WarehouseLocation?       @relation(fields: [locationId], references: [id])
  qaReleasedByName        String?
  qaReleasedAt            DateTime?
  qaRejectReason          String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  ledgerEntries MaterialLedgerEntry[]

  @@index([goodsReceivingId])
  @@index([itemId])
  @@index([status])
}

enum WarehouseRequestStatus {
  REQUESTED
  WAREHOUSE_PREPARING
  RELEASED
  WAITING_PRODUCTION_CONFIRMATION
  PARTIALLY_RECEIVED
  RECEIVED
  IN_PRODUCTION
  RETURN_PENDING
  WAREHOUSE_VERIFYING
  COMPLETED
}

enum ReceiptOutcome {
  ACCEPTED
  REJECTED
  SHORTAGE
  DAMAGED
}

model WarehouseMaterialRequest {
  id              String                 @id @default(cuid())
  requestNumber   String                 @unique
  batchReference  String
  batchSize       Float?
  batchSizeUnit   String?
  requiredDate    DateTime?
  priority        Priority               @default(MEDIUM)
  status          WarehouseRequestStatus @default(REQUESTED)
  requestedByName String
  formulationId   String?
  formulation     Formulation?           @relation(fields: [formulationId], references: [id])
  comments        String?
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt

  lines         WarehouseRequestLine[]
  ledgerEntries MaterialLedgerEntry[]

  @@index([status])
  @@index([batchReference])
}

model WarehouseRequestLine {
  id                     String                   @id @default(cuid())
  requestId              String
  request                WarehouseMaterialRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  itemId                 String?
  item                   WarehouseItem?           @relation(fields: [itemId], references: [id])
  ingredientNameFreeText String?
  requestedQty           Float
  unit                   String

  // Step 2 — warehouse release
  releasedQty       Float?
  releaseLotNumber  String?
  releaseExpiry     DateTime?
  releaseLocationId String?
  releaseLocation   WarehouseLocation? @relation("ReleaseLocation", fields: [releaseLocationId], references: [id])
  releasedByName    String?
  releasedAt        DateTime?
  releaseComments   String?

  // Step 3/4 — production receipt check + confirm
  receiptOutcome  ReceiptOutcome?
  receivedQty     Float?
  receivedByName  String?
  receivedAt      DateTime?
  receiptComments String?

  // Step 5 — usage during production
  usedQty  Float?
  wasteQty Float?

  // Steps 6/7/8 — return + verification
  returnQty              Float?
  returnConditionNotes   String?
  returnLocationId       String?
  returnLocation         WarehouseLocation? @relation("ReturnLocation", fields: [returnLocationId], references: [id])
